{
  "name": "@payfair/engine",
  "version": "0.1.0",
  "private": true,
  "description": "PayFair calculation engine: cash-gap, negotiation ladder, break-even risk, and financing-fallback math. Synthetic seed data only.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./seed": {
      "types": "./dist/seed/suppliers.d.ts",
      "default": "./dist/seed/suppliers.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
